    };
    input.value = '';
  };
  rd.readAsText(f, 'utf-8');
}

/* =========================================================
   真 Excel 导出：内联 ZIP(store) + CRC32 + OOXML
   不依赖任何外部库
   ========================================================= */
var CRC_TABLE = (function(){
  var t = new Uint32Array(256);
  for(var n = 0; n < 256; n++){
    var c = n;
    for(var k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
    t[n] = c >>> 0;
  }
  return t;
})();
function crc32(u8){
  var c = 0xFFFFFFFF;
  for(var i = 0; i < u8.length; i++) c = CRC_TABLE[(c ^ u8[i]) & 0xFF] ^ (c >>> 8);
  return (c ^ 0xFFFFFFFF) >>> 0;
}
function u8(str){ return new TextEncoder().encode(str); }

function makeZip(files){
  var chunks = [], central = [], offset = 0;
  var dt = new Date();
  var dosTime = ((dt.getHours() & 31) << 11) | ((dt.getMinutes() & 63) << 5) | ((dt.getSeconds()/2) & 31);
  var dosDate = (((dt.getFullYear()-1980) & 127) << 9) | (((dt.getMonth()+1) & 15) << 5) | (dt.getDate() & 31);

  files.forEach(function(f){
    var nb = u8(f.name), data = f.data, crc = crc32(data);
    var lh = new Uint8Array(30 + nb.length);
    var dv = new DataView(lh.buffer);
    dv.setUint32(0, 0x04034b50, true);
    dv.setUint16(4, 20, true);
    dv.setUint16(6, 0x0800, true);
    dv.setUint16(8, 0, true);
    dv.setUint16(10, dosTime, true);
    dv.setUint16(12, dosDate, true);
    dv.setUint32(14, crc, true);
    dv.setUint32(18, data.length, true);
    dv.setUint32(22, data.length, true);
    dv.setUint16(26, nb.length, true);
    dv.setUint16(28, 0, true);
    lh.set(nb, 30);
    chunks.push(lh, data);

    var ch = new Uint8Array(46 + nb.length);
    var cv = new DataView(ch.buffer);
    cv.setUint32(0, 0x02014b50, true);
    cv.setUint16(4, 20, true);
    cv.setUint16(6, 20, true);
    cv.setUint16(8, 0x0800, true);
    cv.setUint16(10, 0, true);
    cv.setUint16(12, dosTime, true);
    cv.setUint16(14, dosDate, true);
    cv.setUint32(16, crc, true);
    cv.setUint32(20, data.length, true);
    cv.setUint32(24, data.length, true);
    cv.setUint16(28, nb.length, true);
    cv.setUint16(30, 0, true);
    cv.setUint16(32, 0, true);
    cv.setUint16(34, 0, true);
    cv.setUint16(36, 0, true);
    cv.setUint32(38, 32, true);
    cv.setUint32(42, offset, true);
    ch.set(nb, 46);
    central.push(ch);
    offset += lh.length + data.length;
  });

  var cdSize = central.reduce(function(s, c){ return s + c.length; }, 0);
  var eocd = new Uint8Array(22);
  var ev = new DataView(eocd.buffer);
  ev.setUint32(0, 0x06054b50, true);
  ev.setUint16(8, files.length, true);
  ev.setUint16(10, files.length, true);
  ev.setUint32(12, cdSize, true);
  ev.setUint32(16, offset, true);
  ev.setUint16(20, 0, true);

  return new Blob(chunks.concat(central).concat([eocd]), { type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
}

function xesc(s){
  return String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&apos;')
    .replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g,'');
}
function colName(i){
  var s = '';
  i = i + 1;
  while(i > 0){ var m = (i - 1) % 26; s = String.fromCharCode(65 + m) + s; i = Math.floor((i - 1)/26); }
  return s;
}
/* cell: {v:值, t:'s'|'n', s:样式索引} */
function sheetXml(rows, widths){
  var cols = '';
  if(widths && widths.length){
    cols = '<cols>' + widths.map(function(w, i){
      return '<col min="' + (i+1) + '" max="' + (i+1) + '" width="' + w + '" customWidth="1"/>';
    }).join('') + '</cols>';
  }
  var body = rows.map(function(row, r){
    var cells = row.map(function(c, i){
      if(c == null || c.v === '' || c.v == null) return '';
      var ref = colName(i) + (r+1);
      var st = c.s ? ' s="' + c.s + '"' : '';
      if(c.t === 'n') return '<c r="' + ref + '"' + st + '><v>' + (Number(c.v)||0) + '</v></c>';
      return '<c r="' + ref + '"' + st + ' t="inlineStr"><is><t xml:space="preserve">' + xesc(c.v) + '</t></is></c>';
    }).join('');
    return '<row r="' + (r+1) + '">' + cells + '</row>';
  }).join('');
  return '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">' +
    '<sheetViews><sheetView workbookViewId="0"><pane ySplit="1" topLeftCell="A2" activePane="bottomLeft" state="frozen"/></sheetView></sheetViews>' +
    cols + '<sheetData>' + body + '</sheetData></worksheet>';
}
function buildXlsx(sheets){
  var files = [];
  var ct = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">' +
    '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
    '<Default Extension="xml" ContentType="application/xml"/>' +
    '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>' +
    sheets.map(function(s, i){
      return '<Override PartName="/xl/worksheets/sheet' + (i+1) + '.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>';
    }).join('') +
    '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>' +
    '</Types>';
  files.push({ name:'[Content_Types].xml', data:u8(ct) });

  files.push({ name:'_rels/.rels', data:u8('<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
    '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>' +
    '</Relationships>') });

  var wb = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">' +
    '<sheets>' + sheets.map(function(s, i){
      return '<sheet name="' + xesc(s.name) + '" sheetId="' + (i+1) + '" r:id="rId' + (i+1) + '"/>';
    }).join('') + '</sheets></workbook>';
  files.push({ name:'xl/workbook.xml', data:u8(wb) });

  var rels = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
    sheets.map(function(s, i){
      return '<Relationship Id="rId' + (i+1) + '" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet' + (i+1) + '.xml"/>';
    }).join('') +
    '<Relationship Id="rId' + (sheets.length+1) + '" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>' +
    '</Relationships>';
  files.push({ name:'xl/_rels/workbook.xml.rels', data:u8(rels) });

  var styles = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">' +
    '<numFmts count="2">' +
      '<numFmt numFmtId="176" formatCode="&quot;\u00A5&quot;#,##0.00"/>' +
      '<numFmt numFmtId="177" formatCode="0.0&quot;h&quot;"/>' +
    '</numFmts>' +
    '<fonts count="4">' +
      '<font><sz val="11"/><color theme="1"/><name val="\u7B49\u7EBF"/></font>' +
      '<font><b/><sz val="11"/><color rgb="FFFFFFFF"/><name val="\u7B49\u7EBF"/></font>' +
      '<font><sz val="11"/><color rgb="FFD92D20"/><name val="\u7B49\u7EBF"/></font>' +
      '<font><sz val="11"/><color rgb="FF12855B"/><name val="\u7B49\u7EBF"/></font>' +
    '</fonts>' +
    '<fills count="3">' +
      '<fill><patternFill patternType="none"/></fill>' +
      '<fill><patternFill patternType="gray125"/></fill>' +
      '<fill><patternFill patternType="solid"><fgColor rgb="FF2B5FD9"/><bgColor indexed="64"/></patternFill></fill>' +
    '</fills>' +
    '<borders count="2">' +
      '<border><left/><right/><top/><bottom/><diagonal/></border>' +
      '<border><left/><right/><top/><bottom style="thin"><color rgb="FFE5E9F0"/></bottom><diagonal/></border>' +
    '</borders>' +
    '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>' +
    '<cellXfs count="6">' +
      '<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>' +
      '<xf numFmtId="0" fontId="1" fillId="2" borderId="0" xfId="0" applyFont="1" applyFill="1" applyAlignment="1"><alignment vertical="center"/></xf>' +
      '<xf numFmtId="176" fontId="0" fillId="0" borderId="1" xfId="0" applyNumberFormat="1" applyBorder="1"/>' +
      '<xf numFmtId="176" fontId="2" fillId="0" borderId="1" xfId="0" applyNumberFormat="1" applyFont="1" applyBorder="1"/>' +
      '<xf numFmtId="176" fontId="3" fillId="0" borderId="1" xfId="0" applyNumberFormat="1" applyFont="1" applyBorder="1"/>' +
      '<xf numFmtId="0" fontId="0" fillId="0" borderId="1" xfId="0" applyBorder="1"/>' +
    '</cellXfs>' +
    '<cellStyles count="1"><cellStyle name="\u5E38\u89C4" xfId="0" builtinId="0"/></cellStyles>' +
    '</styleSheet>';
  files.push({ name:'xl/styles.xml', data:u8(styles) });

  sheets.forEach(function(s, i){
    files.push({ name:'xl/worksheets/sheet' + (i+1) + '.xml', data:u8(sheetXml(s.rows, s.widths)) });
  });

  return makeZip(files);
}

/* 样式索引：1=表头 2=金额 3=红色金额 4=绿色金额 5=普通带边框 */
var S_H = 1, S_M = 2, S_MR = 3, S_MG = 4, S_T = 5;
function xlT(v){ return { v:v, t:'s', s:S_T }; }
function xlH(v){ return { v:v, t:'s', s:S_H }; }
function xlM(v, color){ return { v:Number(v)||0, t:'n', s: color === 'r' ? S_MR : color === 'g' ? S_MG : S_M }; }
function xlN(v){ return { v:Number(v)||0, t:'n', s:S_T }; }

function exportXlsx(){
  try{
    var os = state.orders.slice().sort(function(a,b){ return (b.deliver||'').localeCompare(a.deliver||''); });

    /* Sheet1 订单明细 */
    var rows1 = [[
      xlH('订单号'), xlH('交付日期'), xlH('客户'), xlH('来源'), xlH('类型'), xlH('工作内容'), xlH('状态'),
      xlH('报价'), xlH('已收'), xlH('待收'), xlH('收款到期日'), xlH('是否逾期'),
      xlH('耗时(h)'), xlH('报价时薪'), xlH('实收时薪'), xlH('备注')
    ]];
    var tQ = 0, tP = 0, tD = 0, tH = 0;
    os.forEach(function(o){
      var ov = isOverduePay(o);
      tQ += quoteOf(o); tP += paidOf(o); tH += hoursOf(o);
      if(isActive(o)) tD += dueOf(o);
      rows1.push([
        xlT(o.no || ''), xlT(o.deliver || ''), xlT(o.client), xlT(o.source || '其他'), xlT(o.cat || '其他'), xlT(o.title), xlT(o.status),
        xlM(quoteOf(o)), xlM(paidOf(o), paidOf(o) > 0 ? 'g' : ''), xlM(dueOf(o), dueOf(o) > 0 ? 'r' : ''),
        xlT(payDueOf(o) || ''), xlT(ov ? '逾期未收' : (dueOf(o) > 0 ? '待收' : '已结清')),
        xlN(hoursOf(o)),
        xlM(quoteRate(o) || 0), xlM(paidRate(o) || 0, 'g'),
        xlT(o.note || '')
      ]);
    });
    rows1.push([]);
    rows1.push([ xlT('合计'), xlT(''), xlT(''), xlT(''), xlT(''), xlT(os.length + ' 单'), xlT(''),
      xlM(tQ), xlM(tP, 'g'), xlM(tD, 'r'), xlT(''), xlT(''), xlN(tH),
      xlM(tH > 0 ? tQ/tH : 0), xlM(tH > 0 ? tP/tH : 0, 'g'), xlT('') ]);

    /* Sheet2 月度统计 */
    var agg = monthAgg(12);
    var rows2 = [[ xlH('月份'), xlH('订单数'), xlH('报价合计'), xlH('已收'), xlH('待收'), xlH('回款率') ]];
    agg.forEach(function(d){
      rows2.push([
        xlT(d.key), xlN(d.count), xlM(d.quote), xlM(d.paid, 'g'), xlM(d.due, d.due > 0 ? 'r' : ''),
        xlT(d.quote > 0 ? Math.round(d.paid/d.quote*100) + '%' : '—')
      ]);
    });

    /* Sheet3 来源与时薪 */
    var srcMap = {};
    state.orders.forEach(function(o){
      if(!isActive(o)) return;
      var s = o.source || '其他';
      if(!srcMap[s]) srcMap[s] = { n:0, q:0, p:0 };
      srcMap[s].n++; srcMap[s].q += quoteOf(o); srcMap[s].p += paidOf(o);
    });
    var rows3 = [[ xlH('客户来源'), xlH('订单数'), xlH('成交金额'), xlH('已收'), xlH('金额占比') ]];
    var totQ = 0;
    Object.keys(srcMap).forEach(function(k){ totQ += srcMap[k].q; });
    Object.keys(srcMap).sort(function(a,b){ return srcMap[b].q - srcMap[a].q; }).forEach(function(k){
      rows3.push([ xlT(k), xlN(srcMap[k].n), xlM(srcMap[k].q), xlM(srcMap[k].p, 'g'),
        xlT(totQ > 0 ? Math.round(srcMap[k].q/totQ*100) + '%' : '—') ]);
    });
    rows3.push([]);
    rows3.push([ xlH('单子类型'), xlH('订单数'), xlH('总耗时(h)'), xlH('报价时薪'), xlH('实收时薪') ]);
    catAgg().forEach(function(m){
      rows3.push([ xlT(m.cat), xlN(m.count), xlN(m.hours), xlM(m.qRate), xlM(m.pRate, 'g') ]);
    });

    var blob = buildXlsx([
      { name:'订单明细', rows:rows1, widths:[17,12,14,10,8,34,9,12,12,12,13,11,9,12,12,28] },
      { name:'月度统计', rows:rows2, widths:[12,9,14,14,14,10] },
      { name:'来源与时薪', rows:rows3, widths:[14,9,14,14,12] }
    ]);
    download(blob, '副业接单台_对账_' + stamp() + '.xlsx');
    toast('Excel 已导出，含 3 个工作表');
  }catch(e){
    toast('导出失败：' + e.message);
  }
}

/* =========================================================
   初始化
   ========================================================= */
function switchView(v){
  view = v;
  ['orders','search','pay','stats','rate'].forEach(function(x){
    document.getElementById('p-' + x).classList.toggle('on', x === v);
  });
  Array.prototype.forEach.call(document.querySelectorAll('#tabs button, #bnav button'), function(b){
    b.classList.toggle('on', b.getAttribute('data-v') === v);
  });
  window.scrollTo({ top:0, behavior:'smooth' });
}

function init(){
  fillSelect(document.getElementById('f_source'), SOURCES);
  fillSelect(document.getElementById('f_cat'), CATS);
  fillSelect(document.getElementById('f_status'), STATUS);

  Array.prototype.forEach.call(document.querySelectorAll('#tabs button, #bnav button'), function(b){
    b.addEventListener('click', function(){ switchView(b.getAttribute('data-v')); });
  });
  /* 订单页状态筛选 */
  Array.prototype.forEach.call(document.querySelectorAll('.chip[data-f]'), function(c){
    c.addEventListener('click', function(){
      Array.prototype.forEach.call(document.querySelectorAll('.chip[data-f]'), function(x){ x.classList.remove('on'); });
      c.classList.add('on');
      filter = c.getAttribute('data-f');
      renderOrders();
    });
  });
  document.getElementById('q').addEventListener('input', function(e){
    keyword = e.target.value.trim();
    renderOrders();
  });

  /* 搜索模块 */
  fillSelect(document.getElementById('sf_status'), STATUS);
  fillSelect(document.getElementById('sf_source'), SOURCES);
  document.getElementById('sf_status').insertAdjacentHTML('afterbegin', '<option value="">不限状态</option>');
  document.getElementById('sf_source').insertAdjacentHTML('afterbegin', '<option value="">不限来源</option>');
  document.getElementById('sf_status').value = '';
  document.getElementById('sf_source').value = '';

  var sq = document.getElementById('sq');
  sq.addEventListener('input', function(e){ sc.kw = e.target.value.trim(); renderSearch(); });
  sq.addEventListener('keydown', function(e){
    if(e.key === 'Enter'){ pushHistory(sc.kw); sq.blur(); }
  });
  Array.prototype.forEach.call(document.querySelectorAll('.sfld'), function(b){
    b.addEventListener('click', function(){
      Array.prototype.forEach.call(document.querySelectorAll('.sfld'), function(x){ x.classList.remove('on'); });
      b.classList.add('on');
      sc.field = b.getAttribute('data-s');
      renderSearch();
    });
  });
  Array.prototype.forEach.call(document.querySelectorAll('.squick'), function(b){
    b.addEventListener('click', function(){
      var k = b.getAttribute('data-q');
      sc.quick[k] = !sc.quick[k];
      b.classList.toggle('on', !!sc.quick[k]);
      renderSearch();
    });
  });
  ['sf_status','sf_source','sf_from','sf_to'].forEach(function(id){
    document.getElementById(id).addEventListener('change', function(e){
      sc[id.replace('sf_','')] = e.target.value;
      renderSearch();
    });
  });

  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){ closeForm(); closeConfirm(); }
    if((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')){
      e.preventDefault();
      if(!document.getElementById('mask').classList.contains('on')) gotoSearch();
    }
  });

  load();
  render();
}
init();
</script>
