      };
    });
    confirmBox('导入恢复', '共读取到 <b>' + clean.length + '</b> 条订单。<br><br>选择「覆盖」会替换当前 ' + state.orders.length + ' 条数据；如果只想追加，请点下方「追加合并」。',
      function(){
