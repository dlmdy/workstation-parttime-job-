<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#f5f7fa">
<title>副业接单台</title>
<style>
:root{
  --bg:#f4f6f9;
  --card:#ffffff;
  --line:#e5e9f0;
  --line2:#eef1f6;
  --text:#1e2430;
  --muted:#6b7686;
  --faint:#9aa4b2;
  --primary:#2b5fd9;
  --primary-soft:#eaf0fe;
  --red:#d92d20;
  --red-soft:#fdecea;
  --green:#12855b;
  --green-soft:#e6f5ef;
  --amber:#b45309;
  --amber-soft:#fdf3e3;
  --violet:#6d43c4;
  --shadow:0 1px 2px rgba(23,35,58,.05), 0 6px 18px rgba(23,35,58,.05);
  --radius:14px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  font-size:15px;line-height:1.55;
  padding-bottom:calc(76px + env(safe-area-inset-bottom));
}
@media(min-width:769px){body{padding-bottom:40px;}}
.wrap{max-width:1120px;margin:0 auto;padding:0 16px;}

/* ---------- header ---------- */
.appbar{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:60;}
.appbar-in{max-width:1120px;margin:0 auto;padding:12px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;}
.logo{display:flex;align-items:center;gap:9px;font-weight:700;font-size:17px;letter-spacing:.2px;}
.logo .mark{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,#2b5fd9,#5b8def);display:flex;align-items:center;justify-content:center;flex:none;}
.spacer{flex:1;}
.tools{display:flex;gap:8px;flex-wrap:wrap;}

/* ---------- buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  min-height:40px;padding:0 14px;border-radius:10px;
  border:1px solid var(--line);background:#fff;color:var(--text);
  font-size:14px;font-weight:600;font-family:inherit;cursor:pointer;
  transition:background .15s,border-color .15s,transform .06s;
}
.btn:hover{background:#f7f9fc;border-color:#d5dbe6;}
.btn:active{transform:translateY(1px);}
.btn.primary{background:var(--primary);border-color:var(--primary);color:#fff;}
.btn.primary:hover{background:#2350bd;}
.btn.green{background:var(--green);border-color:var(--green);color:#fff;}
.btn.green:hover{background:#0f6f4c;}
.btn.danger{color:var(--red);border-color:#f3cfcb;background:#fff;}
.btn.danger:hover{background:var(--red-soft);}
.btn.sm{min-height:36px;padding:0 11px;font-size:13px;border-radius:9px;}
.btn.block{width:100%;}
.btn svg{flex:none;}
@media(max-width:768px){
  .btn{min-height:44px;padding:0 15px;font-size:15px;}
  .btn.sm{min-height:44px;font-size:14px;padding:0 12px;}
}

/* ---------- fab ---------- */
.fab{
  position:fixed;right:18px;bottom:calc(88px + env(safe-area-inset-bottom));z-index:70;
  width:56px;height:56px;border-radius:18px;border:none;background:var(--primary);color:#fff;
  box-shadow:0 8px 24px rgba(43,95,217,.35);cursor:pointer;display:flex;align-items:center;justify-content:center;
}
@media(min-width:769px){.fab{bottom:28px;}}

/* ---------- notice ---------- */
.notice{margin:12px 0 0;background:var(--amber-soft);border:1px solid #f2dfbe;color:#7c4a06;border-radius:12px;padding:10px 14px;font-size:13.5px;display:flex;gap:10px;align-items:center;}
.notice .x{margin-left:auto;cursor:pointer;color:#a5741f;font-weight:700;padding:4px 8px;}

/* ---------- today ---------- */
.today{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius);
  box-shadow:var(--shadow);margin-top:16px;overflow:hidden;
}
.today-head{padding:14px 18px;border-bottom:1px solid var(--line2);display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:linear-gradient(180deg,#fbfcfe,#fff);}
.today-head h2{margin:0;font-size:16px;font-weight:700;}
.today-head .date{margin-left:auto;color:var(--muted);font-size:13px;font-weight:500;}
.today-list{padding:6px 8px 10px;}
.tdi{display:flex;gap:12px;align-items:flex-start;padding:11px 10px;border-radius:11px;}
.tdi + .tdi{border-top:1px solid var(--line2);}
.tdi .dot{width:8px;height:8px;border-radius:50%;margin-top:8px;flex:none;background:var(--faint);}
.tdi.crit .dot{background:var(--red);}
.tdi.warn .dot{background:var(--amber);}
.tdi.info .dot{background:var(--primary);}
.tdi .body{flex:1;min-width:0;}
.tdi .t1{font-weight:600;font-size:14.5px;}
.tdi.crit .t1{color:var(--red);}
.tdi .t2{color:var(--muted);font-size:13px;margin-top:2px;}
.tdi .acts{display:flex;gap:6px;flex-wrap:wrap;margin-top:2px;}
@media(max-width:600px){.tdi{flex-wrap:wrap;}.tdi .acts{width:100%;margin-top:8px;}}
.empty{padding:26px 16px;text-align:center;color:var(--muted);font-size:14px;}
.empty svg{display:block;margin:0 auto 8px;}

/* ---------- kpi ---------- */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:14px;}
@media(max-width:900px){.kpis{grid-template-columns:repeat(2,1fr);}}
.kpi{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;box-shadow:var(--shadow);}
.kpi .lb{color:var(--muted);font-size:12.5px;font-weight:600;display:flex;align-items:center;gap:6px;}
.kpi .vl{font-size:23px;font-weight:750;margin-top:6px;letter-spacing:-.4px;font-variant-numeric:tabular-nums;}
.kpi .sub{font-size:12px;color:var(--faint);margin-top:3px;}
.money-in{color:var(--green);}
.money-out{color:var(--red);}
.money-wait{color:var(--amber);}

/* ---------- tabs ---------- */
.tabs{display:flex;gap:6px;margin:18px 0 0;background:#fff;border:1px solid var(--line);border-radius:12px;padding:5px;box-shadow:var(--shadow);}
.tabs button{flex:1;min-height:40px;border:none;background:transparent;border-radius:9px;font-size:14.5px;font-weight:600;color:var(--muted);cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:6px;}
.tabs button.on{background:var(--primary-soft);color:var(--primary);}
@media(max-width:768px){.tabs{display:none;}}

/* bottom nav mobile */
.bnav{display:none;}
@media(max-width:768px){
  .bnav{
    display:flex;position:fixed;left:0;right:0;bottom:0;z-index:65;background:#fff;
    border-top:1px solid var(--line);padding:6px 4px calc(6px + env(safe-area-inset-bottom));
  }
  .bnav button{flex:1;min-height:48px;border:none;background:none;font-family:inherit;font-size:11.5px;font-weight:600;color:var(--muted);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;}
  .bnav button.on{color:var(--primary);}
}

/* ---------- panels ---------- */
.panel{display:none;margin-top:14px;}
.panel.on{display:block;}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:14px;overflow:hidden;}
.card-h{padding:13px 18px;border-bottom:1px solid var(--line2);display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.card-h h3{margin:0;font-size:15.5px;font-weight:700;}
.card-h .hint{color:var(--faint);font-size:12.5px;font-weight:500;}
.card-b{padding:14px 18px 18px;}

/* filters */
.filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.chip{border:1px solid var(--line);background:#fff;border-radius:20px;padding:7px 13px;font-size:13.5px;font-weight:600;color:var(--muted);cursor:pointer;min-height:36px;display:inline-flex;align-items:center;}
.chip.on{background:var(--primary);border-color:var(--primary);color:#fff;}
@media(max-width:768px){.chip{min-height:44px;font-size:14.5px;}}
input.search{
  flex:1;min-width:150px;min-height:40px;border:1px solid var(--line);border-radius:10px;
  padding:0 12px;font-size:16px;font-family:inherit;color:var(--text);background:#fff;
}
input.search:focus{outline:2px solid var(--primary-soft);border-color:var(--primary);}

/* ---------- table ---------- */
table{width:100%;border-collapse:collapse;font-size:14px;}
thead th{
  text-align:left;font-size:12.5px;color:var(--muted);font-weight:700;letter-spacing:.2px;
  padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap;background:#fafbfd;
}
tbody td{padding:11px 10px;border-bottom:1px solid var(--line2);vertical-align:middle;}
tbody tr:last-child td{border-bottom:none;}
tbody tr.od{background:#fffafa;}
.num{font-variant-numeric:tabular-nums;white-space:nowrap;}
.cli{font-weight:650;}
.desc{color:var(--muted);font-size:13px;}
.tag{display:inline-flex;align-items:center;border-radius:6px;padding:2px 7px;font-size:12px;font-weight:650;white-space:nowrap;}
.tag.gray{background:#f0f2f6;color:#5c6675;}
.tag.blue{background:var(--primary-soft);color:var(--primary);}
.tag.amber{background:var(--amber-soft);color:var(--amber);}
.tag.green{background:var(--green-soft);color:var(--green);}
.tag.red{background:var(--red-soft);color:var(--red);}
.tag.violet{background:#f1ebfc;color:var(--violet);}
.rowacts{display:flex;gap:6px;justify-content:flex-end;}

@media(max-width:768px){
  table,thead,tbody,tr,td{display:block;}
  thead{display:none;}
  tbody tr{border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:10px;background:#fff;}
  tbody tr.od{background:#fffafa;border-color:#f3cfcb;}
  tbody td{border:none;padding:4px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;}
  tbody td::before{content:attr(data-l);color:var(--muted);font-size:12.5px;font-weight:600;flex:none;}
  tbody td.full{display:block;}
  tbody td.full::before{display:block;margin-bottom:4px;}
  .rowacts{justify-content:stretch;width:100%;}
  .rowacts .btn{flex:1;}
}

/* ---------- charts ---------- */
.chart-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:14px;}
@media(max-width:900px){.chart-grid{grid-template-columns:1fr;}}
svg.chart{display:block;width:100%;height:auto;}
.legend{display:flex;flex-direction:column;gap:9px;margin-top:6px;}
.legend .li{display:flex;align-items:center;gap:9px;font-size:13.5px;}
.legend .sw{width:11px;height:11px;border-radius:3px;flex:none;}
.legend .nm{flex:1;color:var(--text);font-weight:600;}
.legend .vv{color:var(--muted);font-variant-numeric:tabular-nums;}
.lgd-row{display:flex;gap:16px;font-size:13px;color:var(--muted);align-items:center;flex-wrap:wrap;}
.lgd-row span{display:inline-flex;align-items:center;gap:6px;}
.lgd-row i{width:10px;height:10px;border-radius:3px;display:inline-block;}

/* insight */
.insight{background:var(--primary-soft);border:1px solid #d4e0fb;border-radius:12px;padding:13px 15px;font-size:14px;line-height:1.7;}
.insight b{color:var(--primary);}
.insight .li{display:flex;gap:8px;}
.insight .li + .li{margin-top:6px;}

/* ---------- search ---------- */
.searchbox{display:flex;gap:9px;align-items:center;background:#fff;border:1.5px solid var(--line);border-radius:12px;padding:6px 10px 6px 13px;transition:border-color .15s,box-shadow .15s;}
.searchbox:focus-within{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft);}
.searchbox svg{flex:none;color:var(--faint);}
.searchbox input{flex:1;min-width:60px;border:none;outline:none;background:transparent;font-size:16px;font-family:inherit;color:var(--text);min-height:38px;padding:0;}
@media(max-width:768px){.searchbox input{min-height:44px;}}
mark{background:#ffeeb0;color:#7a4b00;border-radius:3px;padding:0 1px;font-weight:700;}
.no{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,"Courier New",monospace;font-size:12px;color:var(--muted);letter-spacing:-.2px;white-space:nowrap;}
.no mark{font-weight:800;}
.slabel{font-size:12.5px;color:var(--muted);font-weight:700;margin-right:2px;}
.adv{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px;}
@media(max-width:768px){.adv{grid-template-columns:1fr 1fr;}}
.hist{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.hist .h{border:1px dashed #d6dde8;background:#fbfcfe;border-radius:18px;padding:0 12px;font-size:13px;color:var(--muted);cursor:pointer;min-height:34px;display:inline-flex;align-items:center;gap:6px;font-family:inherit;}
.hist .h:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-soft);}
@media(max-width:768px){.hist .h{min-height:40px;font-size:14px;}}
.sumbar{display:flex;gap:22px;flex-wrap:wrap;padding:11px 14px;background:#f8fafc;border:1px solid var(--line2);border-radius:11px;margin-bottom:14px;}
.sumbar .it{display:flex;flex-direction:column;gap:1px;}
.sumbar .it .k{font-size:11.5px;color:var(--muted);font-weight:650;}
.sumbar .it .v{font-size:16px;font-weight:750;font-variant-numeric:tabular-nums;}
.kbd{display:inline-block;border:1px solid #d6dde8;border-bottom-width:2px;border-radius:5px;padding:0 5px;font-size:11px;font-family:ui-monospace,Menlo,Consolas,monospace;color:var(--muted);background:#fbfcfe;}
@media(max-width:768px){.kbd{display:none;}}

/* ---------- modal ---------- */
.mask{position:fixed;inset:0;background:rgba(20,28,44,.42);z-index:100;display:none;align-items:flex-start;justify-content:center;padding:24px 12px;overflow-y:auto;}
.mask.on{display:flex;}
.modal{background:#fff;border-radius:16px;width:100%;max-width:560px;box-shadow:0 20px 60px rgba(15,24,42,.25);margin:auto;}
.modal-h{padding:16px 20px;border-bottom:1px solid var(--line2);display:flex;align-items:center;}
.modal-h h3{margin:0;font-size:16.5px;font-weight:700;}
.modal-h .cls{margin-left:auto;border:none;background:none;cursor:pointer;padding:6px;color:var(--muted);border-radius:8px;}
.modal-b{padding:16px 20px;}
.modal-f{padding:14px 20px 18px;display:flex;gap:10px;border-top:1px solid var(--line2);}
.modal-f .btn{flex:1;}
.frm{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.fld{display:flex;flex-direction:column;gap:5px;}
.fld.full{grid-column:1/-1;}
.fld label{font-size:12.5px;font-weight:650;color:var(--muted);}
.fld input,.fld select,.fld textarea{
  min-height:44px;border:1px solid var(--line);border-radius:10px;padding:9px 11px;
  font-size:16px;font-family:inherit;color:var(--text);background:#fff;width:100%;
}
.fld textarea{min-height:66px;resize:vertical;line-height:1.5;}
.fld input:focus,.fld select:focus,.fld textarea:focus{outline:2px solid var(--primary-soft);border-color:var(--primary);}
@media(max-width:520px){.frm{grid-template-columns:1fr;}}

/* toast */
.toast{position:fixed;left:50%;transform:translateX(-50%) translateY(20px);bottom:calc(96px + env(safe-area-inset-bottom));background:#1e2430;color:#fff;padding:11px 18px;border-radius:12px;font-size:14px;font-weight:600;z-index:200;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:88vw;text-align:center;}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0);}
@media(min-width:769px){.toast{bottom:32px;}}

.foot{color:var(--faint);font-size:12.5px;text-align:center;padding:18px 12px 8px;line-height:1.8;}
.hidden{display:none !important;}
</style>
</head>
<body>

<header class="appbar">
  <div class="appbar-in">
    <div class="logo">
      <span class="mark">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-5 4 3 6-7"/><path d="M14 8h5v5"/></svg>
      </span>
      <span>副业接单台</span>
    </div>
    <div class="spacer"></div>
    <div class="tools">
      <button class="btn sm" onclick="gotoSearch()" title="搜索订单（Ctrl+K）">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
        搜索
      </button>
      <button class="btn sm green" onclick="exportXlsx()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13l6 5"/><path d="M15 13l-6 5"/></svg>
        导出 Excel
      </button>
      <button class="btn sm" onclick="exportJSON()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
        导出 JSON
      </button>
      <button class="btn sm" onclick="document.getElementById('impFile').click()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 8l5-5 5 5"/><path d="M12 3v12"/></svg>
        导入恢复
      </button>
      <button class="btn sm danger" onclick="clearSample()">清空示例</button>
      <input type="file" id="impFile" accept=".json,application/json" class="hidden" onchange="importJSON(this)">
    </div>
  </div>
</header>

<div class="wrap">

  <div id="backupNotice" class="notice hidden">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 9v4"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
    <span id="backupNoticeText"></span>
    <span class="x" onclick="dismissNotice()">知道了</span>
  </div>

  <!-- 今天要处理 -->
  <section class="today">
    <div class="today-head">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d92d20" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <h2>今天要处理的</h2>
      <span class="date" id="todayDate"></span>
      <button class="btn sm" onclick="searchByOverdue()">查全部逾期</button>
    </div>
    <div class="today-list" id="todayList"></div>
  </section>

  <!-- KPI -->
  <div class="kpis" id="kpis"></div>

  <!-- Tabs -->
  <nav class="tabs" id="tabs">
    <button data-v="orders" class="on">订单管理</button>
    <button data-v="search">搜索订单</button>
    <button data-v="pay">收款看板</button>
    <button data-v="stats">收入统计</button>
    <button data-v="rate">时薪分析</button>
  </nav>

  <!-- 订单管理 -->
  <section class="panel on" id="p-orders">
    <div class="card">
      <div class="card-h">
        <h3>订单列表</h3>
        <span class="hint" id="orderCount"></span>
        <div class="spacer"></div>
        <button class="btn sm primary" onclick="openForm()">+ 新增订单</button>
      </div>
      <div class="card-b">
        <div class="filters" style="margin-bottom:12px">
          <button class="chip on" data-f="全部">全部</button>
          <button class="chip" data-f="洽谈">洽谈</button>
          <button class="chip" data-f="在做">在做</button>
          <button class="chip" data-f="待验收">待验收</button>
          <button class="chip" data-f="已收款">已收款</button>
          <input class="search" id="q" type="search" placeholder="快速筛选：订单号 / 客户 / 项目名">
          <button class="btn sm" onclick="gotoSearch(document.getElementById('q').value.trim())">高级搜索</button>
        </div>
        <div id="orderTable"></div>
      </div>
    </div>
  </section>

  <!-- 搜索订单 -->
  <section class="panel" id="p-search">
    <div class="card">
      <div class="card-h">
        <h3>搜索订单</h3>
        <span class="hint">订单号 / 客户名 / 项目名，多个词用空格分隔（同时满足）</span>
        <div class="spacer"></div>
        <span class="kbd">Ctrl + K</span>
      </div>
      <div class="card-b">
        <div class="searchbox">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
          <input id="sq" type="search" autocomplete="off" placeholder="如：SO-20260810-01 / 橙子科技 / 落地页">
          <button class="btn sm" onclick="resetSearch()">重置</button>
        </div>

        <div class="filters" style="margin-top:12px">
