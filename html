/* =========================================================
   搜索模块
   ========================================================= */
function matchSearch(o){
  /* 关键词：多个词 AND，按选定字段范围匹配 */
  var kws = sc.kw.split(/\s+/).filter(Boolean);
  if(kws.length){
    var hay;
    if(sc.field === 'no') hay = (o.no || '');
    else if(sc.field === 'client') hay = (o.client || '');
    else if(sc.field === 'title') hay = (o.title || '');
    else if(sc.field === 'note') hay = (o.note || '');
    else hay = [(o.no||''), (o.client||''), (o.title||''), (o.note||''), (o.cat||''), (o.source||'')].join(' ');
    hay = hay.toLowerCase();
    for(var i = 0; i < kws.length; i++){
      if(hay.indexOf(kws[i].toLowerCase()) < 0) return false;
    }
  }
  if(sc.status && o.status !== sc.status) return false;
  if(sc.source && (o.source || '其他') !== sc.source) return false;
  if(sc.from && (!o.deliver || o.deliver < sc.from)) return false;
  if(sc.to && (!o.deliver || o.deliver > sc.to)) return false;
  if(sc.quick.overdue && !isOverduePay(o)) return false;
  if(sc.quick.unpaid && !(dueOf(o) > 0 && isActive(o))) return false;
  if(sc.quick.month && monthKey(o.deliver) !== todayStr().slice(0,7)) return false;
  if(sc.quick.nohours && hoursOf(o) > 0) return false;
  return true;
}

function hasCondition(){
  return !!(sc.kw || sc.status || sc.source || sc.from || sc.to ||
    sc.quick.overdue || sc.quick.unpaid || sc.quick.month || sc.quick.nohours);
}

function renderSearch(){
  renderHistory();
  var hint = document.getElementById('sresHint');
  var sum = document.getElementById('sresSum');
  var tbl = document.getElementById('sresTable');

  if(!hasCondition()){
    hint.textContent = '';
    sum.innerHTML = '';
    tbl.innerHTML = '<div class="empty">' +
      '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#9aa4b2" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>' +
      '输入订单号、客户名或项目名开始搜索，也可以只用下面的筛选条件</div>';
    return;
  }

  var list = state.orders.filter(matchSearch);
  sortOrders(list);
  var kws = sc.kw.split(/\s+/).filter(Boolean);

  hint.textContent = '命中 ' + list.length + ' / 共 ' + state.orders.length + ' 单';

  if(!list.length){
    sum.innerHTML = '';
    tbl.innerHTML = '<div class="empty">没有匹配的订单，试试减少关键词或放宽筛选条件</div>';
    return;
  }

  var q = 0, p = 0, d = 0, ov = 0, h = 0;
  list.forEach(function(o){
    q += quoteOf(o); p += paidOf(o); h += hoursOf(o);
    if(isActive(o)){ d += dueOf(o); if(isOverduePay(o)) ov += dueOf(o); }
  });
  sum.innerHTML = '<div class="sumbar">' +
    '<div class="it"><span class="k">命中订单</span><span class="v">' + list.length + ' 单</span></div>' +
    '<div class="it"><span class="k">报价合计</span><span class="v">' + money(q) + '</span></div>' +
    '<div class="it"><span class="k">已收</span><span class="v money-in">' + money(p) + '</span></div>' +
    '<div class="it"><span class="k">待收</span><span class="v ' + (d > 0 ? 'money-wait' : '') + '">' + money(d) + '</span></div>' +
    '<div class="it"><span class="k">其中逾期</span><span class="v ' + (ov > 0 ? 'money-out' : '') + '">' + money(ov) + '</span></div>' +
    '<div class="it"><span class="k">合计耗时</span><span class="v">' + (Math.round(h*10)/10) + ' h</span></div>' +
    '</div>';
  tbl.innerHTML = ordersTableHtml(list, kws);
}

/* ----- 搜索历史 ----- */
function pushHistory(k){
  k = (k || '').trim();
  if(k.length < 2) return;
  state.history = (state.history || []).filter(function(x){ return x !== k; });
  state.history.unshift(k);
  if(state.history.length > 8) state.history = state.history.slice(0, 8);
  save();
  renderHistory();
}
function renderHistory(){
  var box = document.getElementById('histWrap');
  var h = state.history || [];
  if(!h.length){ box.innerHTML = ''; return; }
  box.innerHTML = '<div class="hist"><span class="slabel">最近搜索</span>' +
    h.map(function(k, i){
      return '<button class="h" onclick="useHistory(' + i + ')">' +
        '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>' +
        esc(k) + '</button>';
    }).join('') +
    '<button class="h" onclick="clearHistory()" style="border-style:solid;color:#d92d20;border-color:#f3cfcb">清除历史</button></div>';
}
function useHistory(i){
  var k = (state.history || [])[i];
  if(k == null) return;
  sc.kw = k;
  document.getElementById('sq').value = k;
  renderSearch();
}
function clearHistory(){
  state.history = [];
  save();
  renderHistory();
  toast('搜索历史已清除');
}

function resetSearch(){
  sc = { kw:'', field:'all', status:'', source:'', from:'', to:'', quick:{} };
  document.getElementById('sq').value = '';
  document.getElementById('sf_status').value = '';
  document.getElementById('sf_source').value = '';
  document.getElementById('sf_from').value = '';
  document.getElementById('sf_to').value = '';
  Array.prototype.forEach.call(document.querySelectorAll('.sfld'), function(b){
    b.classList.toggle('on', b.getAttribute('data-s') === 'all');
  });
  Array.prototype.forEach.call(document.querySelectorAll('.squick'), function(b){ b.classList.remove('on'); });
  renderSearch();
}
function gotoSearch(kw){
  switchView('search');
  var el = document.getElementById('sq');
  if(typeof kw === 'string'){ sc.kw = kw; el.value = kw; renderSearch(); }
  setTimeout(function(){ el.focus(); el.select(); }, 120);
}
function searchByOverdue(){
  resetSearch();
  sc.quick.overdue = true;
  Array.prototype.forEach.call(document.querySelectorAll('.squick'), function(b){
    b.classList.toggle('on', b.getAttribute('data-q') === 'overdue');
  });
  switchView('search');
  renderSearch();
}

