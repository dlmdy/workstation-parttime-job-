/* ----- 今天要处理 ----- */
function renderToday(){
  var box = document.getElementById('todayList');
  var items = [];
  var os = state.orders;

  os.filter(isOverduePay).sort(function(a,b){ return (payDueOf(a)||'').localeCompare(payDueOf(b)||''); }).forEach(function(o){
    var d = Math.abs(diffDays(payDueOf(o)) || 0);
    items.push({
      lv:'crit',
      t1:'逾期未收款 · ' + o.client + ' ' + money(dueOf(o)),
      t2:(o.no ? o.no + ' · ' : '') + '「' + o.title + '」应收日 ' + cnDate(payDueOf(o)) + '，已逾期 ' + d + ' 天',
      acts:[
        { txt:'标记全额收款', cls:'btn sm green', fn:'markPaid(\'' + o.id + '\')' },
        { txt:'编辑', cls:'btn sm', fn:'openForm(\'' + o.id + '\')' }
      ]
    });
  });

  os.filter(isDueToday).forEach(function(o){
    items.push({
      lv:'crit',
      t1:'今天要交付 · ' + o.client,
      t2:(o.no ? o.no + ' · ' : '') + '「' + o.title + '」' + money(quoteOf(o)) + '，当前状态：' + o.status,
      acts:[
        { txt:'转待验收', cls:'btn sm', fn:'setStatus(\'' + o.id + '\',\'待验收\')' },
        { txt:'编辑', cls:'btn sm', fn:'openForm(\'' + o.id + '\')' }
      ]
    });
  });

  os.filter(function(o){ return isLateDeliver(o) && !isDueToday(o); }).forEach(function(o){
    items.push({
      lv:'crit',
      t1:'交付已逾期 · ' + o.client,
      t2:'「' + o.title + '」原定 ' + cnDate(o.deliver) + '，已拖 ' + Math.abs(diffDays(o.deliver)) + ' 天',
      acts:[
        { txt:'顺延到今天', cls:'btn sm', fn:'postpone(\'' + o.id + '\')' },
        { txt:'转待验收', cls:'btn sm', fn:'setStatus(\'' + o.id + '\',\'待验收\')' }
      ]
    });
  });

  os.filter(function(o){
    var dd = diffDays(o.deliver);
    return o.status !== '已收款' && dd !== null && dd > 0 && dd <= 3;
  }).sort(function(a,b){ return (a.deliver||'').localeCompare(b.deliver||''); }).forEach(function(o){
    items.push({
      lv:'warn',
      t1:'即将交付 · ' + o.client + '（还剩 ' + diffDays(o.deliver) + ' 天）',
      t2:'「' + o.title + '」' + cnDate(o.deliver) + ' 交付',
      acts:[{ txt:'编辑', cls:'btn sm', fn:'openForm(\'' + o.id + '\')' }]
    });
  });

  os.filter(function(o){
    if(o.status !== '待验收' || isOverduePay(o)) return false;
    var dd = diffDays(o.deliver);
    return dd !== null && dd <= -3;
  }).forEach(function(o){
    items.push({
      lv:'warn',
      t1:'待验收超 3 天 · ' + o.client,
      t2:'「' + o.title + '」' + cnDate(o.deliver) + ' 已交付，建议催一次验收确认',
      acts:[{ txt:'标记全额收款', cls:'btn sm green', fn:'markPaid(\'' + o.id + '\')' }]
    });
  });

  os.filter(function(o){
    var dd = diffDays(o.deliver);
    return o.status === '洽谈' && dd !== null && dd <= 7;
  }).forEach(function(o){
    items.push({
      lv:'info',
      t1:'待跟进报价 · ' + o.client,
      t2:'「' + o.title + '」报价 ' + money(quoteOf(o)) + '，' + cnDate(o.deliver) + ' 前需确认',
      acts:[{ txt:'确认接单', cls:'btn sm', fn:'setStatus(\'' + o.id + '\',\'在做\')' }]
    });
  });

  if(!items.length){
    box.innerHTML = '<div class="empty">' +
      '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#12855b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>' +
      '今天没有逾期和到期的事项，安心做手上的单</div>';
    return;
  }

  box.innerHTML = items.map(function(it){
    var acts = it.acts.map(function(a){
      return '<button class="' + a.cls + '" onclick="' + a.fn + '">' + a.txt + '</button>';
    }).join('');
    return '<div class="tdi ' + it.lv + '">' +
      '<span class="dot"></span>' +
      '<div class="body"><div class="t1">' + esc(it.t1) + '</div><div class="t2">' + esc(it.t2) + '</div></div>' +
      '<div class="acts">' + acts + '</div></div>';
  }).join('');
}

/* ----- KPI ----- */
function renderKpi(){
  var mk = todayStr().slice(0,7);
  var monthPaid = 0, totalDue = 0, overdue = 0, doneHours = 0, doneMoney = 0, workingCount = 0;
  state.orders.forEach(function(o){
    if(monthKey(o.deliver) === mk) monthPaid += paidOf(o);
    if(isActive(o)) totalDue += dueOf(o);
    if(isOverduePay(o)) overdue += dueOf(o);
    if(hoursOf(o) > 0 && paidOf(o) > 0){ doneHours += hoursOf(o); doneMoney += paidOf(o); }
    if(o.status === '在做' || o.status === '待验收') workingCount++;
  });
  var avgRate = doneHours > 0 ? doneMoney/doneHours : 0;

  var html = '';
  html += kpiCard('本月已收', money(monthPaid), 'money-in', '按交付日期归月');
  html += kpiCard('待收款', money(totalDue), totalDue > 0 ? 'money-wait' : '', '进行中订单 ' + workingCount + ' 单');
  html += kpiCard('逾期未收', money(overdue), overdue > 0 ? 'money-out' : '', overdue > 0 ? '请尽快催收' : '暂无逾期');
  html += kpiCard('平均实收时薪', avgRate > 0 ? money(Math.round(avgRate)) + '/h' : '—', 'money-in', '已收 ÷ 实际耗时');
  document.getElementById('kpis').innerHTML = html;
}
function kpiCard(lb, vl, cls, sub){
  return '<div class="kpi"><div class="lb">' + lb + '</div><div class="vl ' + cls + '">' + vl + '</div><div class="sub">' + sub + '</div></div>';
}

/* ----- 状态标签 ----- */
function statusTag(s){
  var m = { '洽谈':'gray', '在做':'blue', '待验收':'amber', '已收款':'green' };
  return '<span class="tag ' + (m[s]||'gray') + '">' + s + '</span>';
}

/* ----- 关键词高亮 ----- */
function rxEsc(s){ return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
function hl(text, kws){
  var s = esc(text);
  if(!kws || !kws.length) return s;
  var parts = kws.filter(Boolean).map(function(k){ return rxEsc(esc(k)); });
  if(!parts.length) return s;
  try{
    return s.replace(new RegExp('(' + parts.join('|') + ')', 'gi'), '<mark>$1</mark>');
  }catch(e){ return s; }
}

/* ----- 订单表格（订单页 / 搜索页共用） ----- */
function ordersTableHtml(list, kws){
  var rows = list.map(function(o){
    var od = isOverduePay(o) || isDueToday(o) || isLateDeliver(o);
    var dueTxt = dueOf(o) > 0
      ? '<span class="' + (isOverduePay(o) ? 'money-out' : '') + '" style="font-weight:650">' + money(dueOf(o)) + '</span>'
      : '<span style="color:#9aa4b2">—</span>';
    var delTxt = o.deliver
      ? ((isDueToday(o) || isLateDeliver(o)) ? '<span class="money-out" style="font-weight:650">' + cnDate(o.deliver) + (isDueToday(o) ? '（今天）' : '（逾期）') + '</span>' : cnDate(o.deliver))
      : '—';
    return '<tr class="' + (od ? 'od' : '') + '">' +
      '<td data-l="订单号"><span class="no">' + hl(o.no || '—', kws) + '</span></td>' +
      '<td data-l="客户"><span class="cli">' + hl(o.client, kws) + '</span> <span class="tag gray">' + esc(o.source||'其他') + '</span></td>' +
      '<td data-l="工作内容" class="full"><div>' + hl(o.title, kws) + '</div><div class="desc">' + esc(o.cat||'其他') + (o.note ? ' · ' + hl(o.note, kws) : '') + '</div></td>' +
      '<td data-l="报价" class="num">' + money(quoteOf(o)) + '</td>' +
      '<td data-l="已收" class="num money-in">' + (paidOf(o) > 0 ? money(paidOf(o)) : '<span style="color:#9aa4b2">—</span>') + '</td>' +
      '<td data-l="待收" class="num">' + dueTxt + '</td>' +
      '<td data-l="状态">' + statusTag(o.status) + '</td>' +
      '<td data-l="交付日" class="num">' + delTxt + '</td>' +
      '<td data-l="耗时" class="num">' + (hoursOf(o) > 0 ? hoursOf(o) + 'h' : '—') + '</td>' +
      '<td data-l="实收时薪" class="num">' + (paidRate(o) !== null && paidOf(o) > 0 ? money(Math.round(paidRate(o))) + '/h' : '—') + '</td>' +
      '<td><div class="rowacts">' +
        (dueOf(o) > 0 && isActive(o) ? '<button class="btn sm green" onclick="markPaid(\'' + o.id + '\')">收款</button>' : '') +
        '<button class="btn sm" onclick="openForm(\'' + o.id + '\')">编辑</button>' +
      '</div></td>' +
      '</tr>';
  }).join('');
  return '<table><thead><tr>' +
    '<th>订单号</th><th>客户</th><th>工作内容</th><th>报价</th><th>已收</th><th>待收</th><th>状态</th><th>交付日</th><th>耗时</th><th>实收时薪</th><th></th>' +
    '</tr></thead><tbody>' + rows + '</tbody></table>';
}

function sortOrders(list){
  var order = { '在做':0, '待验收':1, '洽谈':2, '已收款':3 };
  return list.sort(function(a,b){
    var d = (order[a.status]||9) - (order[b.status]||9);
    if(d !== 0) return d;
    return (a.deliver||'9999').localeCompare(b.deliver||'9999');
  });
}

/* ----- 订单表 ----- */
function renderOrders(){
  var list = state.orders.slice();
  if(filter !== '全部') list = list.filter(function(o){ return o.status === filter; });
  var kws = [];
  if(keyword){
    kws = keyword.split(/\s+/).filter(Boolean);
