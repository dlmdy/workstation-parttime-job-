   ========================================================= */
var KEY = 'wb_sideorder_v1';
var SOURCES = ['小红书','朋友介绍','闲鱼','公众号','抖音','平台派单','老客户复购','其他'];
var CATS    = ['设计','文案','编程','剪辑','咨询','运营','其他'];
var STATUS  = ['洽谈','在做','待验收','已收款'];
var PIE_COLORS = ['#2b5fd9','#12855b','#e8a33d','#6d43c4','#d9578a','#0f9bb0','#8a97a8','#c26a2b'];

var state = { orders: [], seeded: false, noticeAt: 0, history: [] };
var view = 'orders';
var filter = '全部';
var keyword = '';
var editingId = null;
/* 搜索模块状态 */
var sc = { kw:'', field:'all', status:'', source:'', from:'', to:'', quick:{} };

/* ---------- 日期工具 ---------- */
function pad(n){ return n < 10 ? '0' + n : '' + n; }
function ymd(d){ return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()); }
function today(){ var d = new Date(); d.setHours(0,0,0,0); return d; }
function todayStr(){ return ymd(today()); }
function shift(n){ var d = today(); d.setDate(d.getDate()+n); return ymd(d); }
function parseD(s){ if(!s) return null; var p = String(s).split('-'); if(p.length<3) return null; var d = new Date(+p[0], +p[1]-1, +p[2]); d.setHours(0,0,0,0); return d; }
function diffDays(s){ var d = parseD(s); if(!d) return null; return Math.round((d - today())/86400000); }
function cnDate(s){ if(!s) return '—'; var p = String(s).split('-'); return (+p[1]) + '月' + (+p[2]) + '日'; }
function monthKey(s){ return s ? String(s).slice(0,7) : ''; }

/* ---------- 金额 ---------- */
function money(n){
  n = Number(n) || 0;
  var s = Math.abs(n).toLocaleString('zh-CN',{minimumFractionDigits:0, maximumFractionDigits:2});
  return (n < 0 ? '-¥' : '¥') + s;
}
function esc(s){
  return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ---------- 订单派生字段 ---------- */
function quoteOf(o){ return Number(o.quote) || 0; }
function paidOf(o){ return Math.min(Number(o.received)||0, quoteOf(o)); }
function dueOf(o){ return Math.max(0, quoteOf(o) - paidOf(o)); }
function hoursOf(o){ return Number(o.hours) || 0; }
function payDueOf(o){
  if(o.paydue) return o.paydue;
  if(o.deliver){ var d = parseD(o.deliver); if(d){ d.setDate(d.getDate()+7); return ymd(d); } }
  return '';
}
function isActive(o){ return o.status !== '洽谈'; }
function isOverduePay(o){
  if(!isActive(o) || dueOf(o) <= 0) return false;
  var pd = payDueOf(o); if(!pd) return false;
  return parseD(pd) < today();
}
function isDueToday(o){
  return o.status !== '已收款' && o.deliver === todayStr();
}
function isLateDeliver(o){
  if(o.status === '已收款' || o.status === '待验收') return false;
  if(!o.deliver) return false;
  return parseD(o.deliver) < today();
}
function quoteRate(o){ var h = hoursOf(o); return h > 0 ? quoteOf(o)/h : null; }
function paidRate(o){ var h = hoursOf(o); return h > 0 ? paidOf(o)/h : null; }

/* ---------- 存储 ---------- */
function save(){
  try{ localStorage.setItem(KEY, JSON.stringify(state)); }
  catch(e){ toast('保存失败：本地存储空间可能已满'); }
}
function load(){
  var raw = null;
  try{ raw = localStorage.getItem(KEY); }catch(e){}
  if(raw){
    try{
      var o = JSON.parse(raw);
      if(o && Array.isArray(o.orders)){
        state = o;
        if(!state.noticeAt) state.noticeAt = 0;
        if(!Array.isArray(state.history)) state.history = [];
        migrateNo();
        return;
      }
    }catch(e){}
  }
  state = { orders: sampleData(), seeded: true, noticeAt: 0, history: [] };
  migrateNo();
  save();
}
function uid(){ return 'o' + Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

/* ---------- 订单号：SO-YYYYMMDD-NN ---------- */
function genNo(dateStr){
  var base = String(dateStr || todayStr()).replace(/-/g, '');
  if(base.length !== 8) base = todayStr().replace(/-/g, '');
  var prefix = 'SO-' + base + '-';
  var max = 0;
  state.orders.forEach(function(o){
    if(o.no && String(o.no).indexOf(prefix) === 0){
      var n = parseInt(String(o.no).slice(prefix.length), 10);
      if(!isNaN(n) && n > max) max = n;
    }
  });
  return prefix + pad(max + 1);
}
/* 老数据 / 导入数据自动补号：按交付日期先后编号，已有号码保留 */
function migrateNo(){
  var lack = state.orders.filter(function(o){ return !o.no; });
  if(!lack.length) return;
  lack.sort(function(a, b){ return (a.deliver || '').localeCompare(b.deliver || ''); });
  lack.forEach(function(o){ o.no = genNo(o.deliver || todayStr()); });
}

/* ---------- 示例数据（相对当前日期） ---------- */
function sampleData(){
  function mShift(m, day){
    var d = today(); d.setDate(1); d.setMonth(d.getMonth() + m); d.setDate(day);
    return ymd(d);
  }
  return [
