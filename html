/* ----- 月度聚合 ----- */
function monthsBack(n){
  var arr = [], d = today();
  d.setDate(1);
  for(var i = n-1; i >= 0; i--){
    var t = new Date(d.getFullYear(), d.getMonth()-i, 1);
    arr.push({ key: t.getFullYear() + '-' + pad(t.getMonth()+1), label: (t.getMonth()+1) + '月' });
  }
  return arr;
}
function monthAgg(n){
  var ms = monthsBack(n);
  var map = {};
  ms.forEach(function(m){ map[m.key] = { key:m.key, label:m.label, paid:0, due:0, quote:0, count:0 }; });
  state.orders.forEach(function(o){
    var k = monthKey(o.deliver);
    if(!map[k]) return;
    map[k].paid += paidOf(o);
    map[k].quote += quoteOf(o);
    map[k].count += 1;
    if(isActive(o)) map[k].due += dueOf(o);
  });
  return ms.map(function(m){ return map[m.key]; });
}

/* ----- 统计（柱状图 + 饼图） ----- */
function renderStats(){
  var data = monthAgg(6);
  var max = 0;
  data.forEach(function(d){ max = Math.max(max, d.paid + d.due); });
  if(max <= 0) max = 1000;
  var step = niceStep(max);
  var top = Math.ceil(max/step)*step;

  var W = 620, H = 280, padL = 56, padR = 14, padB = 40, padT = 14;
  var cw = W - padL - padR, ch = H - padT - padB;
  var svg = '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="月度收入柱状图">';

  for(var g = 0; g <= top; g += step){
    var y = padT + ch - (g/top)*ch;
    svg += '<line x1="' + padL + '" y1="' + y.toFixed(1) + '" x2="' + (W-padR) + '" y2="' + y.toFixed(1) + '" stroke="' + (g===0 ? '#c9d1de' : '#eef1f6') + '" stroke-width="1"/>';
    svg += '<text x="' + (padL-8) + '" y="' + (y+4).toFixed(1) + '" text-anchor="end" font-size="11" fill="#9aa4b2">' + (g >= 10000 ? (g/10000) + '万' : g) + '</text>';
  }

  var slot = cw / data.length;
  var bw = Math.min(46, slot*0.46);
  data.forEach(function(d, i){
    var cx = padL + slot*i + slot/2;
    var hPaid = (d.paid/top)*ch, hDue = (d.due/top)*ch;
    var yPaid = padT + ch - hPaid;
    var yDue = yPaid - hDue;
    if(d.paid > 0)
      svg += '<rect x="' + (cx-bw/2).toFixed(1) + '" y="' + yPaid.toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + Math.max(hPaid,1).toFixed(1) + '" fill="#12855b" rx="3"/>';
    if(d.due > 0)
      svg += '<rect x="' + (cx-bw/2).toFixed(1) + '" y="' + yDue.toFixed(1) + '" width="' + bw.toFixed(1) + '" height="' + Math.max(hDue,1).toFixed(1) + '" fill="#e8a33d" rx="3"/>';
    var tot = d.paid + d.due;
    if(tot > 0)
      svg += '<text x="' + cx.toFixed(1) + '" y="' + (yDue - 6).toFixed(1) + '" text-anchor="middle" font-size="11.5" font-weight="700" fill="#1e2430">' + Math.round(tot).toLocaleString('zh-CN') + '</text>';
    svg += '<text x="' + cx.toFixed(1) + '" y="' + (H - padB + 20) + '" text-anchor="middle" font-size="12" fill="#6b7686">' + d.label + '</text>';
  });
  svg += '</svg>';
  document.getElementById('barChart').innerHTML = svg;

  /* 饼图：客户来源占比（按成交金额=报价，排除洽谈） */
  var srcMap = {};
  state.orders.forEach(function(o){
    if(!isActive(o)) return;
    var s = o.source || '其他';
    srcMap[s] = (srcMap[s] || 0) + quoteOf(o);
  });
  var arr = Object.keys(srcMap).map(function(k){ return { name:k, val:srcMap[k] }; })
    .filter(function(x){ return x.val > 0; })
    .sort(function(a,b){ return b.val - a.val; });
  var total = arr.reduce(function(s,x){ return s + x.val; }, 0);

  if(!total){
    document.getElementById('pieChart').innerHTML = '<div class="empty">还没有成交订单</div>';
    document.getElementById('pieLegend').innerHTML = '';
  }else{
    var S = 240, cxp = 120, cyp = 118, R = 88, r2 = 54;
    var p = '<svg class="chart" viewBox="0 0 ' + S + ' ' + (S+4) + '" style="max-width:280px;margin:0 auto" role="img" aria-label="客户来源占比">';
    var ang = -Math.PI/2;
    arr.forEach(function(x, i){
      var a2 = ang + (x.val/total) * Math.PI * 2;
      p += '<path d="' + donutPath(cxp, cyp, R, r2, ang, a2) + '" fill="' + PIE_COLORS[i % PIE_COLORS.length] + '"/>';
      ang = a2;
    });
    p += '<text x="' + cxp + '" y="' + (cyp - 4) + '" text-anchor="middle" font-size="12" fill="#6b7686">成交总额</text>';
    p += '<text x="' + cxp + '" y="' + (cyp + 17) + '" text-anchor="middle" font-size="16" font-weight="750" fill="#1e2430">' + money(total) + '</text>';
    p += '</svg>';
    document.getElementById('pieChart').innerHTML = p;
    document.getElementById('pieLegend').innerHTML = arr.map(function(x, i){
      return '<div class="li"><span class="sw" style="background:' + PIE_COLORS[i % PIE_COLORS.length] + '"></span>' +
        '<span class="nm">' + esc(x.name) + '</span>' +
        '<span class="vv">' + money(x.val) + ' · ' + Math.round(x.val/total*100) + '%</span></div>';
    }).join('');
  }

  var mrows = monthAgg(6).slice().reverse().map(function(d){
    return '<tr>' +
      '<td data-l="月份"><span class="cli">' + d.key + '</span></td>' +
      '<td data-l="订单数" class="num">' + d.count + '</td>' +
      '<td data-l="报价合计" class="num">' + money(d.quote) + '</td>' +
      '<td data-l="已收" class="num money-in">' + money(d.paid) + '</td>' +
      '<td data-l="待收" class="num ' + (d.due > 0 ? 'money-wait' : '') + '">' + money(d.due) + '</td>' +
      '</tr>';
  }).join('');
  document.getElementById('monthTable').innerHTML =
    '<table><thead><tr><th>月份</th><th>订单数</th><th>报价合计</th><th>已收</th><th>待收</th></tr></thead><tbody>' + mrows + '</tbody></table>';
}
function niceStep(max){
  var raw = max/4;
  var pow = Math.pow(10, Math.floor(Math.log(raw)/Math.LN10));
  var n = raw/pow;
  var m = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
  return m * pow;
}
function donutPath(cx, cy, R, r, a1, a2){
  var full = (a2 - a1) >= Math.PI*2 - 0.0001;
  if(full) a2 = a1 + Math.PI*1.9999;
  var large = (a2 - a1) > Math.PI ? 1 : 0;
  var x1 = cx + R*Math.cos(a1), y1 = cy + R*Math.sin(a1);
  var x2 = cx + R*Math.cos(a2), y2 = cy + R*Math.sin(a2);
  var x3 = cx + r*Math.cos(a2), y3 = cy + r*Math.sin(a2);
  var x4 = cx + r*Math.cos(a1), y4 = cy + r*Math.sin(a1);
  return 'M' + x1.toFixed(2) + ' ' + y1.toFixed(2) +
         ' A' + R + ' ' + R + ' 0 ' + large + ' 1 ' + x2.toFixed(2) + ' ' + y2.toFixed(2) +
         ' L' + x3.toFixed(2) + ' ' + y3.toFixed(2) +
         ' A' + r + ' ' + r + ' 0 ' + large + ' 0 ' + x4.toFixed(2) + ' ' + y4.toFixed(2) + ' Z';
}

/* ----- 时薪分析 ----- */
function catAgg(){
  var map = {};
  state.orders.forEach(function(o){
    if(hoursOf(o) <= 0) return;
    var c = o.cat || '其他';
    if(!map[c]) map[c] = { cat:c, hours:0, quote:0, paid:0, count:0 };
    map[c].hours += hoursOf(o);
    map[c].quote += quoteOf(o);
    map[c].paid += paidOf(o);
    map[c].count += 1;
  });
  return Object.keys(map).map(function(k){
    var m = map[k];
    m.qRate = m.hours > 0 ? m.quote/m.hours : 0;
    m.pRate = m.hours > 0 ? m.paid/m.hours : 0;
    return m;
  }).sort(function(a,b){ return b.pRate - a.pRate; });
}

function renderRate(){
  var arr = catAgg();
  if(!arr.length){
    document.getElementById('rateChart').innerHTML = '<div class="empty">还没有填写实际耗时的订单，填上耗时才能算时薪</div>';
    document.getElementById('rateTable').innerHTML = '';
    document.getElementById('insight').innerHTML = '在订单里填写「实际耗时」，这里会自动算出哪类单更值得接。';
    return;
  }

  var maxR = 0;
  arr.forEach(function(m){ maxR = Math.max(maxR, m.qRate, m.pRate); });
  if(maxR <= 0) maxR = 100;

  var W = 620, rowH = 52, padL = 62, padR = 86, padT = 8;
  var H = padT + arr.length*rowH + 10;
  var bw = W - padL - padR;
  var s = '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="各类型时薪对比">';
  arr.forEach(function(m, i){
    var y = padT + i*rowH;
    var w1 = Math.max(2, (m.qRate/maxR)*bw);
    var w2 = Math.max(2, (m.pRate/maxR)*bw);
    s += '<text x="' + (padL-10) + '" y="' + (y+26) + '" text-anchor="end" font-size="13" font-weight="700" fill="#1e2430">' + esc(m.cat) + '</text>';
    s += '<rect x="' + padL + '" y="' + (y+6) + '" width="' + w1.toFixed(1) + '" height="15" rx="4" fill="#b9c9ee"/>';
    s += '<rect x="' + padL + '" y="' + (y+25) + '" width="' + w2.toFixed(1) + '" height="15" rx="4" fill="#12855b"/>';
    s += '<text x="' + (padL + Math.max(w1,w2) + 8) + '" y="' + (y+18) + '" font-size="11.5" fill="#6b7686">报价 ' + money(Math.round(m.qRate)) + '/h</text>';
    s += '<text x="' + (padL + Math.max(w1,w2) + 8) + '" y="' + (y+37) + '" font-size="11.5" font-weight="700" fill="#12855b">实收 ' + money(Math.round(m.pRate)) + '/h</text>';
  });
  s += '</svg>';
  document.getElementById('rateChart').innerHTML =
    '<div class="lgd-row" style="margin-bottom:10px"><span><i style="background:#b9c9ee"></i>报价时薪</span><span><i style="background:#12855b"></i>实收时薪</span></div>' + s;

  var det = state.orders.filter(function(o){ return hoursOf(o) > 0; })
    .sort(function(a,b){ return (paidRate(b)||0) - (paidRate(a)||0); });
  var rows = det.map(function(o){
    var pr = paidRate(o) || 0, qr = quoteRate(o) || 0;
    var gap = qr > 0 ? Math.round((1 - pr/qr)*100) : 0;
    return '<tr>' +
      '<td data-l="客户"><span class="cli">' + esc(o.client) + '</span></td>' +
      '<td data-l="工作内容" class="full">' + esc(o.title) + ' <span class="tag violet">' + esc(o.cat||'其他') + '</span></td>' +
      '<td data-l="报价" class="num">' + money(quoteOf(o)) + '</td>' +
      '<td data-l="耗时" class="num">' + hoursOf(o) + 'h</td>' +
      '<td data-l="报价时薪" class="num">' + money(Math.round(qr)) + '/h</td>' +
      '<td data-l="实收时薪" class="num ' + (pr > 0 ? 'money-in' : 'money-out') + '" style="font-weight:700">' + money(Math.round(pr)) + '/h</td>' +
      '<td data-l="缩水">' + (gap > 0 ? '<span class="tag red">缩水 ' + gap + '%</span>' : '<span class="tag green">足额</span>') + '</td>' +
      '</tr>';
  }).join('');
  document.getElementById('rateTable').innerHTML =
    '<table><thead><tr><th>客户</th><th>工作内容</th><th>报价</th><th>耗时</th><th>报价时薪</th><th>实收时薪</th><th>回款情况</th></tr></thead><tbody>' + rows + '</tbody></table>';

  /* 建议 */
  var best = arr[0], worst = arr[arr.length-1];
  var totalH = 0, totalP = 0;
  arr.forEach(function(m){ totalH += m.hours; totalP += m.paid; });
  var avg = totalH > 0 ? totalP/totalH : 0;
  var tips = [];
  tips.push('<div class="li"><b>·</b><span>整体实收时薪 <b>' + money(Math.round(avg)) + '/h</b>，累计投入 ' + Math.round(totalH) + ' 小时，已落袋 ' + money(totalP) + '。</span></div>');
  if(arr.length > 1 && best.pRate > 0){
    tips.push('<div class="li"><b>·</b><span>最值得接：<b>' + esc(best.cat) + '</b>（实收 ' + money(Math.round(best.pRate)) + '/h，' + best.count + ' 单），比整体均值高 ' + (avg > 0 ? Math.round((best.pRate/avg - 1)*100) : 0) + '%，建议优先接、并尝试涨价。</span></div>');
    tips.push('<div class="li"><b>·</b><span>最不划算：<b>' + esc(worst.cat) + '</b>（实收 ' + money(Math.round(worst.pRate)) + '/h，' + worst.count + ' 单）' + (worst.pRate < avg*0.7 ? '，明显拉低整体收益，建议提价或减少承接。' : '，尚可，但注意控制改稿次数。') + '</span></div>');
  }
  var shrink = arr.filter(function(m){ return m.qRate > 0 && m.pRate < m.qRate*0.8; });
  if(shrink.length){
    tips.push('<div class="li"><b>·</b><span><span class="money-out" style="font-weight:700">回款提醒</span>：' +
      shrink.map(function(m){ return esc(m.cat); }).join('、') + ' 类订单实收时薪明显低于报价时薪，说明钱还没收齐，优先去催这几单的尾款。</span></div>');
  }
  var hi = det[0];
  if(hi && paidRate(hi) > 0){
    tips.push('<div class="li"><b>·</b><span>单笔时薪冠军：<b>' + esc(hi.client) + ' · ' + esc(hi.title) + '</b>（' + money(Math.round(paidRate(hi))) + '/h），这类客户值得重点维护复购。</span></div>');
  }
  document.getElementById('insight').innerHTML = tips.join('');
}

