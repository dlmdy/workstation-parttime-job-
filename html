    { id:uid(), client:'阿 May', source:'老客户复购', cat:'剪辑', title:'口播短视频剪辑 8 条',
      quote:2400, received:1200, status:'在做', deliver:shift(5), paydue:shift(12), hours:11,
      note:'示例数据 · 包月合作，月中付一半', sample:true },
    { id:uid(), client:'唐记餐饮', source:'小红书', cat:'文案', title:'新品菜单文案改写',
      quote:800, received:0, status:'洽谈', deliver:shift(12), paydue:'', hours:0,
      note:'示例数据 · 还在谈价，未开工', sample:true },
    { id:uid(), client:'星野文化', source:'小红书', cat:'设计', title:'公众号长图设计 2 组',
      quote:1800, received:1800, status:'已收款', deliver:shift(-24), paydue:shift(-17), hours:9,
      note:'示例数据 · 已结清', sample:true },
    { id:uid(), client:'知了教育', source:'公众号', cat:'咨询', title:'账号定位诊断（2 小时会议 + 报告）',
      quote:2600, received:2600, status:'已收款', deliver:mShift(-1, 18), paydue:mShift(-1, 20), hours:6,
      note:'示例数据 · 时薪最高的一类单', sample:true },
    { id:uid(), client:'宁夏果园', source:'平台派单', cat:'剪辑', title:'电商主图视频 6 条',
      quote:3000, received:3000, status:'已收款', deliver:mShift(-2, 12), paydue:mShift(-2, 20), hours:26,
      note:'示例数据 · 改稿多，实际很不划算', sample:true }
  ];
}

/* =========================================================
   渲染
   ========================================================= */
function render(){
  document.getElementById('todayDate').textContent =
    (new Date()).getFullYear() + '年' + (new Date().getMonth()+1) + '月' + new Date().getDate() + '日 星期' + '日一二三四五六'[new Date().getDay()];
